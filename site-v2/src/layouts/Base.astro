---
import '../styles/tokens.css';
import { legal, cta, plausibleDomain } from '../site';

interface Props {
  title: string;
  description: string;
  /** Legal pages stay out of the index, same as today. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://wundermgmt.com').href;
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://wundermgmt.com').href;

const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/proof', label: 'Proof' },
  { href: '/who-we-work-with', label: 'Who we work with' },
  { href: '/switching', label: 'Switching' },
  { href: '/company', label: 'Company' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Favicon: own wordmark, generated from the site's own CI tokens and the -->
    <!-- Anton display font already shipped here. No third party icon service. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Social share preview. Image: own generated wordmark, 1200x630, no stock art. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wunder" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wunder, managed against your own numbers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/epilogue-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      plausibleDomain && (
        <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Wunder',
        legalName: legal.company,
        url: 'https://wundermgmt.com',
        identifier: legal.regNumber,
        address: {
          '@type': 'PostalAddress',
          streetAddress: legal.street,
          addressLocality: 'Riga',
          postalCode: 'LV-1050',
          addressCountry: 'LV',
        },
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Wunder</a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <a
                class="nav-link"
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="nav-link login"
            href="https://wunderportal.com"
            rel="nofollow noopener"
            target="_blank">Creator login</a
          >
          <a class="cta header-cta" href={cta.primaryHref}>{cta.primary}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="caption entity">
          {legal.brandLine}, reg. {legal.regNumber}, {legal.street}, {legal.city}, {legal.country}.
        </p>
        <p class="caption footer-links">
          <a href="/imprint">Imprint</a>
          <span aria-hidden="true"> / </span>
          <a href="/privacy">Privacy</a>
          <span aria-hidden="true"> / </span>
          <a href="https://wunderportal.com" rel="nofollow noopener" target="_blank"
            >Creator login</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--ground);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    flex-wrap: wrap;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .nav-link {
    font-size: 15px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--text);
  }

  /* Creator login stays a quiet text link, never a button. Concept 4.7. */
  .login {
    color: var(--text-muted);
    text-decoration: underline;
  }

  .header-cta {
    font-size: 15px;
    padding: 10px 18px;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 40px 0;
    margin-top: 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .entity,
  .footer-links {
    margin: 0;
  }

  @media (max-width: 860px) {
    .header-inner {
      padding-top: 16px;
      padding-bottom: 16px;
    }
    .nav {
      gap: 14px;
    }
    .header-cta {
      display: inline-block;
      width: auto;
    }
  }
</style>

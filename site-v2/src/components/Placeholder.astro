---
/*
  Image placeholder. Inline SVG, no network request, no layout shift.
  Every real image on this site has to be own production photography with a
  written release from the person shown (04-konzept.md section 5.4, point 4).
  No release exists today, so nothing but this placeholder is used.
*/

interface Props {
  label: string;
  ratio?: 'wide' | 'portrait' | 'square';
}

const { label, ratio = 'wide' } = Astro.props;
const size = {
  wide: { w: 1200, h: 700 },
  portrait: { w: 800, h: 1000 },
  square: { w: 900, h: 900 },
}[ratio];
---

<figure class="ph">
  <svg
    viewBox={`0 0 ${size.w} ${size.h}`}
    role="img"
    aria-label={`Placeholder: ${label}`}
    preserveAspectRatio="xMidYMid slice"
  >
    <rect width="100%" height="100%" fill="#141416"></rect>
    <rect
      x="1"
      y="1"
      width={size.w - 2}
      height={size.h - 2}
      fill="none"
      stroke="#2a2a2d"
      stroke-width="2"></rect>
    <line x1="0" y1="0" x2={size.w} y2={size.h} stroke="#2a2a2d" stroke-width="1"></line>
    <line x1={size.w} y1="0" x2="0" y2={size.h} stroke="#2a2a2d" stroke-width="1"></line>
    <text
      x="50%"
      y="50%"
      fill="#9a9691"
      font-family="Epilogue, Helvetica, Arial, sans-serif"
      font-size="28"
      text-anchor="middle"
      dominant-baseline="middle">{label}</text
    >
  </svg>
</figure>

<style>
  .ph {
    margin: 0;
  }

  .ph svg {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
